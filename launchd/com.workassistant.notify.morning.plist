<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.workassistant.notify.morning</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/python@3.12/libexec/bin/python3</string>
        <string>__WORK_ASSISTANT_ROOT__/通知.py</string>
        <string>morning</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__WORK_ASSISTANT_ROOT__/数据/_notify.log</string>
    <key>StandardErrorPath</key>
    <string>__WORK_ASSISTANT_ROOT__/数据/_notify.log</string>
</dict>
</plist>
