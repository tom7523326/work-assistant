<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.workassistant.menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__WORK_ASSISTANT_ROOT__/菜单栏.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__WORK_ASSISTANT_ROOT__/数据/_menubar.log</string>
    <key>StandardErrorPath</key>
    <string>__WORK_ASSISTANT_ROOT__/数据/_menubar.log</string>
</dict>
</plist>
